extends SceneTree
## Gemini-only runtime contract. Hermes must NOT run this or any Godot process.
const Inventory = preload("res://scripts/inventory.gd")

func _initialize() -> void:
	var bag = Inventory.new()
	assert(bag.CAPACITY == 18)
	assert(bag.HOTBAR_SIZE == 9)
	assert(bag.occupied_count() == 0)
	assert(bag.equipped_id().is_empty())
	assert(not bag.add_item("unknown"))
	assert(not bag.add_item("sword", 0))
	assert(not bag.equip(0))
	assert(bag.add_item("sword"))
	assert(bag.get_slot(0).get("id") == "sword")
	assert(bag.equip(0))
	assert(bag.equipped_id() == "sword")
	assert(bag.equip(0))
	assert(bag.equipped_id().is_empty())
	assert(bag.equip(0))
	var copy: Dictionary = bag.get_slot(0)
	copy["id"] = "lantern"
	assert(bag.equipped_id() == "sword", "Slot snapshots must not mutate inventory")
	var removed: Dictionary = bag.remove_slot(0)
	assert(removed.get("id") == "sword")
	assert(bag.equipped_id().is_empty())
	assert(bag.occupied_count() == 0)
	assert(bag.remove_slot(-1).is_empty())
	assert(not bag.equip(99))
	for index in range(bag.CAPACITY):
		assert(bag.add_item("lantern"))
	assert(bag.occupied_count() == bag.CAPACITY)
	assert(not bag.add_item("spring_coil"))
	assert(bag.occupied_count() == bag.CAPACITY, "Failed pickup must not mutate a full bag")
	assert(bag.equip(12))
	assert(bag.equipped_id() == "lantern")
	assert(bag.remove_slot(12).get("id") == "lantern")
	assert(bag.equipped_id().is_empty())
	assert(bag.occupied_count() == bag.CAPACITY - 1)
	assert(not bag.add_item("sword", 2), "Multi-item adds must be atomic")
	assert(bag.occupied_count() == bag.CAPACITY - 1)
	assert(bag.add_item("spring_coil"))
	assert(bag.occupied_count() == bag.CAPACITY)
	print("Inventory runtime contracts passed on the machine executing this script.")
	quit(0)
