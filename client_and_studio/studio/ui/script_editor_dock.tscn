[gd_scene load_steps=2 format=3 uid="uid://c8luani00scripteditor"]

[ext_resource type="Script" path="res://studio/ui/script_editor_dock.gd" id="1_scripteditor"]

[node name="ScriptEditorDock" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 6
